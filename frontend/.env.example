# Copy this file to .env.local for local overrides (rarely needed — the
# Vite dev proxy in vite.config.js already forwards /api to localhost:8000).
#
# For a DEPLOYED frontend (e.g. on Vercel), set this same variable in the
# platform's dashboard (Project Settings -> Environment Variables) to your
# live backend's URL:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
#
# Leave it unset for local development.
VITE_API_BASE_URL=
