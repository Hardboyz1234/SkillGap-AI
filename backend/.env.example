# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string

# SQLite by default. For production, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skillgap
DATABASE_URL=sqlite+aiosqlite:///./skillgap.db

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash

# Optional but recommended — raises GitHub API rate limit 60/hr -> 5000/hr
# Create at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

FRONTEND_ORIGIN=http://localhost:5173
